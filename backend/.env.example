DATABASE_URL=postgresql+psycopg://fieldnotes:fieldnotes-dev@localhost:5432/fieldnotes
JWT_SECRET=replace-with-a-long-random-secret
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated browser origins allowed to call the API from a different host.
# Leave as-is for local dev. When the built SPA is served by FastAPI itself (the
# Docker/Railway setup) requests are same-origin and this value becomes irrelevant.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
